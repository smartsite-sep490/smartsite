{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartsite.local/contracts/v1/camera-configuration-ack.json",
  "title": "CameraConfigurationAcknowledgement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "commandId",
    "workerGenerationId",
    "streamSessionId",
    "configurationVersion",
    "bundleSha256",
    "viewRevision",
    "outcome"
  ],
  "properties": {
    "commandId": { "$ref": "#/$defs/lowercaseUuid" },
    "workerGenerationId": { "$ref": "#/$defs/lowercaseUuid" },
    "streamSessionId": { "$ref": "#/$defs/lowercaseUuid" },
    "configurationVersion": { "$ref": "#/$defs/version" },
    "bundleSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "viewRevision": { "$ref": "#/$defs/version" },
    "outcome": { "enum": ["LOADED", "REJECTED"] },
    "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" }
  },
  "oneOf": [
    {
      "properties": { "outcome": { "const": "LOADED" }, "reasonCode": false }
    },
    { "properties": { "outcome": { "const": "REJECTED" } } }
  ],
  "$defs": {
    "lowercaseUuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
  }
}
