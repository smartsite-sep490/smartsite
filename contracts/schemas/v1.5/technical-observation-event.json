{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartsite.local/contracts/v1.5/technical-observation-event.json",
  "title": "TrackedFrameObservationEventCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "schemaVersion",
    "cameraExternalId",
    "streamSessionId",
    "capturedAt",
    "frameDimensions",
    "observations",
    "evidence",
    "framePartition",
    "continuity"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "schemaVersion": {
      "const": "1.5.0"
    },
    "cameraExternalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000]+$"
    },
    "streamSessionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:(?:[0-5][0-9]|60)(?:\\.[0-9]+)?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "frameDimensions": {
      "$ref": "https://smartsite.local/contracts/v1.4/technical-observation-event.json#/$defs/frameDimensions"
    },
    "observations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "$ref": "https://smartsite.local/contracts/v1.4/technical-observation-event.json#/$defs/observation"
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "https://smartsite.local/contracts/v1.4/technical-observation-event.json#/$defs/evidenceItem"
      }
    },
    "framePartition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frameId", "sequenceNumber", "partIndex", "partCount"],
      "properties": {
        "frameId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "sequenceNumber": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "maxLength": 20
        },
        "partIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        },
        "partCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        }
      }
    },
    "continuity": {
      "$ref": "#/$defs/continuity"
    }
  },
  "$defs": {
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "profileSha256", "coverage", "subjects", "retiredSegments"],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "profileSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "coverage": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status"],
              "properties": {
                "status": {
                  "const": "COMPLETE"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "reason"],
              "properties": {
                "status": {
                  "const": "INCOMPLETE"
                },
                "reason": {
                  "enum": ["INFERENCE_ERROR", "AMBIGUOUS_PROCESSING", "FRAME_DROPPED"]
                }
              }
            }
          ]
        },
        "subjects": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/subject"
          }
        },
        "retiredSegments": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["segmentId", "reason"],
            "properties": {
              "segmentId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "reason": {
                "enum": [
                  "RECONNECT",
                  "AMBIGUOUS_ASSOCIATION",
                  "LOST_TRACK",
                  "FRAME_DISCONTINUITY",
                  "VIEW_CHANGE",
                  "CONFIGURATION_CHANGE",
                  "EXPIRED_INTERVAL",
                  "PROFILE_CHANGE"
                ]
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "coverage": {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "INCOMPLETE"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "subjects": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["personObservationIndex", "segmentId", "link"],
      "properties": {
        "personObservationIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "segmentId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "link": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "reason"],
              "properties": {
                "kind": {
                  "const": "START"
                },
                "reason": {
                  "enum": [
                    "INITIAL",
                    "RECONNECT",
                    "AMBIGUOUS_ASSOCIATION",
                    "LOST_TRACK",
                    "FRAME_DISCONTINUITY",
                    "VIEW_CHANGE",
                    "CONFIGURATION_CHANGE",
                    "EXPIRED_INTERVAL",
                    "PROFILE_CHANGE"
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "previousEventId", "previousPersonObservationIndex"],
              "properties": {
                "kind": {
                  "const": "CONTINUE"
                },
                "previousEventId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "previousPersonObservationIndex": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                }
              }
            }
          ]
        }
      }
    }
  },
  "description": "Explicit opt-in structure only; continuity claims require separate authenticated Backend admission and qualified producer profile."
}
