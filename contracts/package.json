{
  "name": "@smartsite/contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "schemas"
  ],
  "exports": {
    "./ai-frame-evidence": "./dist/ai-frame-evidence.js",
    "./camera-preview": "./dist/camera-preview.js",
    "./camera-policy-configuration-bundle": "./dist/camera-policy-configuration-bundle.js",
    "./camera-policy-configuration-bundle-v21": "./dist/camera-policy-configuration-bundle-v21.js",
    "./camera-ppe-policy-command": "./dist/camera-ppe-policy-command.js",
    "./leave-notice": "./dist/leave-notice.js",
    "./scheduled-shift": "./dist/scheduled-shift.js",
    "./camera-ppe-policy": "./dist/camera-ppe-policy.js",
    ".": "./dist/index.js",
    "./management": "./dist/management-api.js",
    "./camera-region-reference": "./dist/camera-region-reference-command.js",
    "./camera-region-geometry-confirmation": "./dist/camera-region-geometry-confirmation.js",
    "./gates": "./dist/gates-api.js",
    "./worker-document-dates": "./dist/worker-document-dates.js",
    "./camera-configuration-image": "./dist/camera-configuration-image.js",
    "./camera-application-status": "./dist/camera-application-status.js",
    "./safety-episodes": "./dist/safety-episode-api.js",
    "./tracked-episode-frames": "./dist/tracked-episode-frames.js",
    "./camera-observation-zones": "./dist/camera-observation-zones.js",
    "./ppe-items": "./dist/ppe-items.js",
    "./safety-identification": "./dist/safety-identification-api.js",
    "./browser-camera-uplink": "./dist/browser-camera-uplink.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm run build && node -e \"require('node:fs').rmSync('.test-build',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node -e \"require('node:fs').cpSync('schemas','.test-build/schemas',{recursive:true})\" && node --test .test-build/test/*.test.js"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "canonicalize": "2.0.0"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "typescript": "6.0.3"
  }
}
