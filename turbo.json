{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"],
      "env": ["VITE_API_URL", "EXPO_PUBLIC_API_URL", "CI"]
    },
    "typecheck": { "dependsOn": ["^build"], "outputs": [] },
    "test": { "dependsOn": ["^build"], "outputs": [] },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "NODE_ENV",
        "PORT",
        "DATABASE_URL",
        "DIRECT_URL",
        "DATABASE_URL_UNPOOLED",
        "DATABASE_TIMEOUT_MS",
        "CORS_ORIGINS",
        "LOG_LEVEL",
        "LOG_FORMAT",
        "HTTP_RATE_LIMIT_TTL_MS",
        "HTTP_RATE_LIMIT_LIMIT",
        "AI_RATE_LIMIT_TTL_MS",
        "AI_RATE_LIMIT_LIMIT",
        "SMARTSITE_AI_SERVICE_TOKEN",
        "ALERT_COOLDOWN_SECONDS",
        "MAX_PAST_EVENT_AGE_SECONDS",
        "MAX_FUTURE_CLOCK_SKEW_SECONDS",
        "VITE_API_URL",
        "EXPO_PUBLIC_API_URL"
      ]
    }
  }
}
