// Incident source index
// CREATE UNIQUE INDEX uq_incident_checklist_result ON public.incident USING btree (source_checklist_result_id) WHERE (source_checklist_result_id IS NOT NULL);

Table safety_checklist_assignment {
 Note: 'Checklist trước công việc; khóa nhóm, Zone, công việc, thời gian, người nhận và tiêu chí khi giao. ACCEPTED là ghi nhận báo cáo, không cấp phép làm việc hay chặn lịch/chấm công.'
 id uuid [pk, not null]
 site_id uuid [not null]
 contractor_id uuid [not null]
 team_id uuid [not null]
 zone_id uuid [not null]
 description varchar(2000) [not null]
 starts_at timestamptz [not null]
 ends_at timestamptz [not null]
 assigned_to uuid [not null]
 assigned_by uuid [not null]
 status varchar(16) [not null, default: `'ASSIGNED'::character varying`]
 version integer [not null, default: `1`]
 created_at timestamptz [not null, default: `now()`]
 updated_at timestamptz [not null, default: `now()`]
 checks {
  `((char_length(TRIM(BOTH FROM description)) >= 1) AND (char_length(TRIM(BOTH FROM description)) <= 2000))` [name: 'ck_checklist_description']
  `(ends_at > starts_at)` [name: 'ck_checklist_interval']
  `((status)::text = ANY ((ARRAY['ASSIGNED'::character varying, 'IN_PROGRESS'::character varying, 'SUBMITTED'::character varying, 'ACCEPTED'::character varying, 'CANCELLED'::character varying])::text[]))` [name: 'ck_checklist_status']
  `(version > 0)` [name: 'ck_checklist_version']
 }
}
// CREATE INDEX idx_checklist_assignee ON public.safety_checklist_assignment USING btree (assigned_to, status);
// CREATE INDEX idx_checklist_site_created ON public.safety_checklist_assignment USING btree (site_id, created_at, id);
// CREATE UNIQUE INDEX safety_checklist_assignment_pkey ON public.safety_checklist_assignment USING btree (id);

Table safety_checklist_item {
 Note: 'Tiêu chí snapshot theo lần giao; bất biến sau khi giao.'
 id uuid [pk, not null]
 assignment_id uuid [not null]
 position integer [not null]
 text varchar(1000) [not null]
 evidence_required boolean [not null]
 indexes {
  (assignment_id, position) [unique, name: 'uq_checklist_item_position']
  (id, assignment_id) [unique, name: 'uq_checklist_item_scope']
 }
 checks {
  `(("position" >= 0) AND ("position" <= 29))` [name: 'ck_checklist_item_position']
  `((char_length(TRIM(BOTH FROM text)) >= 1) AND (char_length(TRIM(BOTH FROM text)) <= 1000))` [name: 'ck_checklist_item_text']
 }
}
// CREATE UNIQUE INDEX safety_checklist_item_pkey ON public.safety_checklist_item USING btree (id);
// CREATE UNIQUE INDEX uq_checklist_item_position ON public.safety_checklist_item USING btree (assignment_id, "position");
// CREATE UNIQUE INDEX uq_checklist_item_scope ON public.safety_checklist_item USING btree (id, assignment_id);

Table safety_checklist_submission {
 Note: 'Append-only attempts, một PENDING; Safety khác người nộp ghi nhận hoặc trả lại một lần.'
 id uuid [pk, not null]
 assignment_id uuid [not null]
 submitted_by uuid [not null]
 submitted_at timestamptz [not null, default: `now()`]
 status varchar(16) [not null, default: `'PENDING'::character varying`]
 reviewed_by uuid [null]
 reviewed_at timestamptz [null]
 review_note varchar(2000) [null]
 indexes {
  (id, assignment_id) [unique, name: 'uq_checklist_submission_scope']
 }
 checks {
  `((((status)::text = 'PENDING'::text) AND (reviewed_by IS NULL) AND (reviewed_at IS NULL) AND (review_note IS NULL)) OR (((status)::text = ANY ((ARRAY['ACCEPTED'::character varying, 'RETURNED'::character varying])::text[])) AND (reviewed_by IS NOT NULL) AND (reviewed_at IS NOT NULL) AND ((char_length(TRIM(BOTH FROM review_note)) >= 1) AND (char_length(TRIM(BOTH FROM review_note)) <= 2000)) AND (reviewed_by <> submitted_by)))` [name: 'ck_checklist_review']
  `((status)::text = ANY ((ARRAY['PENDING'::character varying, 'ACCEPTED'::character varying, 'RETURNED'::character varying])::text[]))` [name: 'ck_checklist_submission_status']
 }
}
// CREATE UNIQUE INDEX safety_checklist_submission_pkey ON public.safety_checklist_submission USING btree (id);
// CREATE UNIQUE INDEX uq_checklist_pending ON public.safety_checklist_submission USING btree (assignment_id) WHERE ((status)::text = 'PENDING'::text);
// CREATE UNIQUE INDEX uq_checklist_submission_scope ON public.safety_checklist_submission USING btree (id, assignment_id);

Table safety_checklist_item_result {
 Note: 'FAIL trong báo cáo ACCEPTED có thể mở tối đa một Incident; trách nhiệm vẫn cần Safety xác minh.'
 id uuid [pk, not null]
 assignment_id uuid [not null]
 submission_id uuid [not null]
 item_id uuid [not null]
 answer varchar(16) [not null]
 note varchar(2000) [not null, default: `''::character varying`]
 indexes {
  (submission_id, item_id) [unique, name: 'uq_checklist_result_item']
 }
 checks {
  `((answer)::text = ANY ((ARRAY['PASS'::character varying, 'FAIL'::character varying, 'NOT_APPLICABLE'::character varying])::text[]))` [name: 'ck_checklist_answer']
  `((char_length((note)::text) <= 2000) AND (((answer)::text = 'PASS'::text) OR (char_length(TRIM(BOTH FROM note)) > 0)))` [name: 'ck_checklist_result_note']
 }
}
// CREATE UNIQUE INDEX safety_checklist_item_result_pkey ON public.safety_checklist_item_result USING btree (id);
// CREATE UNIQUE INDEX uq_checklist_result_item ON public.safety_checklist_item_result USING btree (submission_id, item_id);

Table safety_checklist_result_evidence {
 Note: 'Liên kết nhiều JPEG/PNG/PDF vào evidence chung; không sao chép object R2.'
 result_id uuid [not null]
 evidence_id uuid [not null]
 indexes {
  (result_id, evidence_id) [pk, name: 'safety_checklist_result_evidence_pkey']
 }
}
// CREATE UNIQUE INDEX safety_checklist_result_evidence_pkey ON public.safety_checklist_result_evidence USING btree (result_id, evidence_id);
Ref fk_incident_checklist_result: incident.source_checklist_result_id > safety_checklist_item_result.id [delete: restrict, update: no action]
Ref fk_checklist_assignee: safety_checklist_assignment.assigned_to > app_user.id [delete: restrict, update: no action]
Ref fk_checklist_contractor: safety_checklist_assignment.contractor_id > contractor.id [delete: restrict, update: no action]
Ref fk_checklist_creator: safety_checklist_assignment.assigned_by > app_user.id [delete: restrict, update: no action]
Ref fk_checklist_site: safety_checklist_assignment.site_id > site.id [delete: restrict, update: no action]
Ref fk_checklist_team_scope: safety_checklist_assignment.(team_id, site_id, contractor_id) > contractor_team.(id, site_id, contractor_id) [delete: restrict, update: no action]
Ref fk_checklist_zone: safety_checklist_assignment.zone_id > zone.id [delete: restrict, update: no action]
Ref fk_checklist_item_assignment: safety_checklist_item.assignment_id > safety_checklist_assignment.id [delete: restrict, update: no action]
Ref fk_checklist_result_item: safety_checklist_item_result.(item_id, assignment_id) > safety_checklist_item.(id, assignment_id) [delete: restrict, update: no action]
Ref fk_checklist_result_submission: safety_checklist_item_result.(submission_id, assignment_id) > safety_checklist_submission.(id, assignment_id) [delete: restrict, update: no action]
Ref fk_checklist_evidence_file: safety_checklist_result_evidence.evidence_id > safety_evidence.id [delete: restrict, update: no action]
Ref fk_checklist_evidence_result: safety_checklist_result_evidence.result_id > safety_checklist_item_result.id [delete: restrict, update: no action]
Ref fk_checklist_reviewer: safety_checklist_submission.reviewed_by > app_user.id [delete: restrict, update: no action]
Ref fk_checklist_submission_assignment: safety_checklist_submission.assignment_id > safety_checklist_assignment.id [delete: restrict, update: no action]
Ref fk_checklist_submitter: safety_checklist_submission.submitted_by > app_user.id [delete: restrict, update: no action]
