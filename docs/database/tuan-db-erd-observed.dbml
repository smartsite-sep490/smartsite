Ref fk_absence_request_expected_version: absence_request.expected_schedule_version_id > schedule_version.id [delete: restrict, update: no action]
Ref fk_absence_request_replacement_worker: absence_request.replacement_worker_id > worker.id [delete: restrict, update: no action]
Ref fk_absence_request_requested_by: absence_request.requested_by_user_id > app_user.id [delete: restrict, update: no action]
Ref fk_absence_request_reviewed_by: absence_request.reviewed_by_user_id > app_user.id [delete: restrict, update: no action]
Ref fk_absence_request_shift: absence_request.shift_id > shift.id [delete: restrict, update: no action]
Ref fk_absence_request_site: absence_request.site_id > site.id [delete: restrict, update: no action]
Ref fk_absence_request_worker: absence_request.worker_id > worker.id [delete: restrict, update: no action]
Ref fk_absence_request_worker_schedule: absence_request.worker_schedule_id > worker_schedule.id [delete: restrict, update: no action]
Ref fk_attempt_assignment: access_attempt.worker_assignment_id > worker_site_zone_assignment.id [delete: restrict, update: no action]
Ref fk_attempt_credential: access_attempt.credential_id > qr_credential.id [delete: restrict, update: no action]
Ref fk_attempt_operator: access_attempt.operator_id > app_user.id [delete: restrict, update: no action]
Ref fk_attempt_reviewer: access_attempt.reviewed_by > app_user.id [delete: restrict, update: no action]
Ref fk_attempt_site: access_attempt.site_id > site.id [delete: restrict, update: no action]
Ref fk_attempt_visit: access_attempt.visit_id > visitor_visit.id [delete: restrict, update: no action]
Ref fk_attempt_worker: access_attempt.worker_id > worker.id [delete: restrict, update: no action]
Ref fk_event_resolved_camera: ai_observation_event.resolved_camera_id > camera.id [delete: set null, update: no action]
Ref fk_mapping_alert: alert_detection_mapping.alert_id > safety_alert.id [delete: cascade, update: no action]
Ref fk_mapping_event: alert_detection_mapping.event_id > ai_observation_event.event_id [delete: cascade, update: no action]
Ref fk_attendance_anomaly_pair: attendance_anomaly.attendance_pair_id > attendance_pair.id [delete: cascade, update: no action]
Ref fk_attendance_anomaly_site: attendance_anomaly.site_id > site.id [delete: restrict, update: no action]
Ref fk_attendance_correction_requester: attendance_correction.requested_by > app_user.id [delete: restrict, update: no action]
Ref fk_attendance_correction_reviewer: attendance_correction.reviewed_by > app_user.id [delete: restrict, update: no action]
Ref fk_attendance_correction_session: attendance_correction.attendance_session_id > attendance_session.id [delete: restrict, update: no action]
Ref fk_attendance_correction_pair: attendance_correction_request.attendance_pair_id > attendance_pair.id [delete: restrict, update: no action]
Ref fk_attendance_correction_requested_by: attendance_correction_request.requested_by_user_id > app_user.id [delete: restrict, update: no action]
Ref fk_attendance_correction_reviewed_by: attendance_correction_request.reviewed_by_user_id > app_user.id [delete: restrict, update: no action]
Ref fk_attendance_correction_site: attendance_correction_request.site_id > site.id [delete: restrict, update: no action]
Ref attendance_day_reviewed_by_fkey: attendance_day.reviewed_by > app_user.id [delete: restrict, update: no action]
Ref attendance_day_schedule_id_fkey: attendance_day.schedule_id > worker_schedule.id [delete: restrict, update: no action]
