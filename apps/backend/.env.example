NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://smartsite:smartsite_local_only@localhost:5432/smartsite
DATABASE_TIMEOUT_MS=2000
CORS_ORIGINS=http://localhost:5173
# Development-only JWT signing secret. Production must supply a separate random value
# containing at least 32 non-whitespace characters through its secret manager.
AUTH_JWT_SECRET=smartsite_local_dev_jwt_secret_only_32_bytes
# Optional one-time Admin bootstrap settings. Set all three to skip prompts;
# remove BOOTSTRAP_ADMIN_PASSWORD after the first successful bootstrap.
# Password: 8-128 characters with at least one uppercase letter, number, and special character.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_DISPLAY_NAME=Initial Admin
# BOOTSTRAP_ADMIN_PASSWORD=
# Optional for migration commands: Neon direct (non-pooled) TLS connection.
# CLI migration commands prioritize: DIRECT_URL > DATABASE_URL_UNPOOLED > DATABASE_URL.
# Runtime continues to use DATABASE_URL (pooled connection).
# DIRECT_URL=
# DATABASE_URL_UNPOOLED=

# Service-to-service authentication token for AI ingestion.
# Production MUST configure at least 32 random bytes, encoded without whitespace.
# Development/test falls back to smartsite_local_dev_service_token_only.
SMARTSITE_AI_SERVICE_TOKEN=smartsite_local_dev_service_token_only
# Optional Backend -> AI enrollment transport. Keep unset to fail closed when
# the AI service is unavailable. Use the same service token in local development.
SMARTSITE_AI_IDENTITY_URL=http://127.0.0.1:8000
# Camera UUIDs the AI service may read, comma-separated. Empty denies configuration reads.
AI_CONFIGURATION_CAMERA_IDS=
# Optional source-image readers for polygon authoring. Empty denies upstream reads.
# JSON maps camera external IDs to exact HTTP(S) origins, without credentials/paths.
# Reading an existing image does not start a camera or inference worker.
SMARTSITE_AI_PREVIEW_SOURCES={}
# Optional development/demo storage root shared with the AI worker. Configure the
# canonical real directory, not a symlink or junction. Production object storage is separate.
# EVIDENCE_LOCAL_ROOT=D:\Ky9-FPT\SmartSiteData\runtime\evidence
ALERT_COOLDOWN_SECONDS=60
# Queue only; does not activate an assessment worker. Explicit capacity required when enabled.
MF06_ENQUEUE_ENABLED=false
# MF06_ENQUEUE_MAX_OUTSTANDING=1000
MAX_PAST_EVENT_AGE_SECONDS=300
MAX_FUTURE_CLOCK_SKEW_SECONDS=30

LOG_LEVEL=info
# pretty is accepted only in development; test and production require json.
LOG_FORMAT=pretty
HTTP_RATE_LIMIT_TTL_MS=60000
HTTP_RATE_LIMIT_LIMIT=120
AI_RATE_LIMIT_TTL_MS=60000
AI_RATE_LIMIT_LIMIT=600
# Shared private file storage. No public bucket URL or credentials are returned to clients.
STORAGE_PROVIDER=LOCAL
# Keep the same root to continue reading existing local files.
# STORAGE_LOCAL_ROOT=D:\SmartSiteData\uploads
# Configure all four fields when choosing R2; do not commit real credentials.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
RESEND_API_KEY=
# Verified sender address in Resend; shared by visitor and account email.
# Leave both blank to disable delivery (account email workflows then return unavailable).
RESEND_FROM_EMAIL=
# Backend-owned document OCR, one-time setup: pnpm ocr:setup.
# Windows Python path (Linux/macOS use ocr/.venv/bin/python):
# WORKER_DOCUMENT_PYTHON=ocr/.venv/Scripts/python.exe
# WORKER_DOCUMENT_TESSERACT=C:/Program Files/Tesseract-OCR/tesseract.exe
# WORKER_DOCUMENT_PDFTOPPM=C:/tools/poppler/Library/bin/pdftoppm.exe
WORKER_DOCUMENT_NOTICE_DAYS=30
# Optional. Inject the key server-side from Secret Manager on Cloud Run.
# OPENAI_API_KEY=
# Optional model override for worker document analysis.
# WORKER_DOCUMENT_OPENAI_MODEL=gpt-4.1-mini

# Remote push for native development/production builds (Expo Go remains on in-app polling).
EXPO_PUSH_ENABLED=false
# Set when enhanced push security is enabled for your Expo project.
EXPO_ACCESS_TOKEN=

# Enable only after frame admission migration and producer compatibility are verified.
AI_PARTITIONED_FRAME_ENABLED=false
# Source preparation only: EVENT_LOCAL projection does not deliver notifications.
# Keep off until schema, writer coordination and rollout are separately qualified.
SAFETY_EPISODE_PROJECTION_ENABLED=false
# Required explicit UUID when enabled; records a configuration choice, not a fleet fence.
# SAFETY_EPISODE_ROUTE_EPOCH=90a50f41-a175-40f9-bd53-d17627f77d1c

# Optional tracked v1.6 runtime. See docs/operations/tracked-frame-runtime.md.
AI_TRACKED_FRAME_RUNTIME_ENABLED=false
AI_EVIDENCE_OBJECT_STORAGE_ENABLED=false
SAFETY_TRACKED_HISTORY_READ_ENABLED=false
# Explicit reviewed schema/profile required before either flag can be enabled.
# SMARTSITE_DB_MIGRATION_PROFILE=tracked-v16
# DATABASE_SCHEMA=smartsite_demo_tracked
# AI_TRACKED_FRAME_RUNTIME_POLICY=<server-reviewed JSON policy>

# Optional scoped Officer-to-Manager identification workflow; requires reviewed C02 schema.
SAFETY_IDENTIFICATION_ENABLED=false
# SMARTSITE_DB_MIGRATION_PROFILE=tracked-v16-identification
# To also install the approved Camera/Region PPE v2 storage on that reviewed schema:
# SMARTSITE_DB_MIGRATION_PROFILE=tracked-v16-identification-ppe
# For the separately reviewed v1.7 Camera PPE wire/fence, select instead:
# SMARTSITE_DB_MIGRATION_PROFILE=tracked-v17-identification-ppe
# This selection alone enables no workflow and never runs startup migrations.

# Optional trusted site AI source-control hosts; empty disables connection testing.
# Example uses a fake site UUID; HTTP loopback is allowed only outside production.
SMARTSITE_AI_SOURCE_HOSTS=[]
# Off by default. Requires an explicitly configured generation-bound source driver.
SMARTSITE_AI_SOURCE_APPLY_ENABLED=false

WORKER_DOCUMENT_OPENAI_TIMEOUT_MS=30000
