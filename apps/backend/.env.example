NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://smartsite:smartsite_local_only@localhost:5432/smartsite
DATABASE_TIMEOUT_MS=2000
CORS_ORIGINS=http://localhost:5173
# Development-only JWT signing secret. Production must supply a separate random value
# containing at least 32 non-whitespace characters through its secret manager.
AUTH_JWT_SECRET=smartsite_local_dev_jwt_secret_only_32_bytes
# Optional one-time Admin bootstrap settings. Set all three to skip prompts;
# remove BOOTSTRAP_ADMIN_PASSWORD after the first successful bootstrap.
# Password: 8-128 characters with at least one uppercase letter, number, and special character.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_DISPLAY_NAME=Initial Admin
# BOOTSTRAP_ADMIN_PASSWORD=
# Optional for migration commands: Neon direct (non-pooled) TLS connection.
# CLI migration commands prioritize: DIRECT_URL > DATABASE_URL_UNPOOLED > DATABASE_URL.
# Runtime continues to use DATABASE_URL (pooled connection).
# DIRECT_URL=
# DATABASE_URL_UNPOOLED=

# Service-to-service authentication token for AI ingestion.
# Production MUST configure at least 32 random bytes, encoded without whitespace.
# Development/test falls back to smartsite_local_dev_service_token_only.
SMARTSITE_AI_SERVICE_TOKEN=smartsite_local_dev_service_token_only
# Camera UUIDs the AI service may read, comma-separated. Empty denies configuration reads.
AI_CONFIGURATION_CAMERA_IDS=
# Optional development/demo storage root shared with the AI worker. Configure the
# canonical real directory, not a symlink or junction. Production object storage is separate.
# EVIDENCE_LOCAL_ROOT=D:\Ky9-FPT\SmartSiteData\runtime\evidence
ALERT_COOLDOWN_SECONDS=60
MAX_PAST_EVENT_AGE_SECONDS=300
MAX_FUTURE_CLOCK_SKEW_SECONDS=30

LOG_LEVEL=info
# pretty is accepted only in development; test and production require json.
LOG_FORMAT=pretty
HTTP_RATE_LIMIT_TTL_MS=60000
HTTP_RATE_LIMIT_LIMIT=120
AI_RATE_LIMIT_TTL_MS=60000
AI_RATE_LIMIT_LIMIT=600
