# Copy to .env.test; only integration tests read this file.
# Dedicated local PostgreSQL; never use runtime, migration, or hosted database credentials.
TEST_DATABASE_URL=postgresql://smartsite_test:smartsite_test_only@127.0.0.1:5433/smartsite_test

# Enable only after frame admission migration and producer compatibility are verified.
AI_PARTITIONED_FRAME_ENABLED=false

# Keep ordinary tests free of automatic camera recovery/background work.
AI_TRACKED_FRAME_RUNTIME_ENABLED=false
SAFETY_TRACKED_HISTORY_READ_ENABLED=false
# Focused integration fixtures select their owned schema/profile explicitly.
SAFETY_IDENTIFICATION_ENABLED=false
# Optional isolated rehearsal only; migration CLI and runtime must share the selection/schema.
# SMARTSITE_DB_MIGRATION_PROFILE=tracked-v16-identification-ppe
# DATABASE_SCHEMA=isolated_test_explicit_owned_schema
