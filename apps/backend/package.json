{
  "name": "@smartsite/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:contracts": "pnpm --filter @smartsite/contracts build",
    "dev": "pnpm build:contracts && nest start --watch",
    "build": "pnpm build:contracts && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "pnpm build:contracts && tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test scripts",
    "lint:fix": "eslint src test scripts --fix",
    "test": "pnpm build:contracts && node -e \"require('node:fs').rmSync('.test-build',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node scripts/run-tests.mjs",
    "test:integration": "pnpm build:contracts && node -e \"require('node:fs').rmSync('.test-build',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node scripts/run-tests.mjs --integration",
    "typeorm": "typeorm",
    "db:migrate:run": "pnpm build && typeorm migration:run -d dist/database/typeorm.data-source.js",
    "db:migrate:revert": "pnpm build && typeorm migration:revert -d dist/database/typeorm.data-source.js",
    "db:migrate:show": "pnpm build && typeorm migration:show -d dist/database/typeorm.data-source.js",
    "db:migrate:generate": "pnpm build && typeorm migration:generate -d dist/database/typeorm.data-source.js",
    "auth:bootstrap-admin": "pnpm build && node dist/scripts/bootstrap-admin.js"
  },
  "dependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/throttler": "6.7.0",
    "@nestjs/typeorm": "12.0.1",
    "@smartsite/contracts": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "16.4.7",
    "helmet": "8.3.0",
    "nestjs-pino": "5.2.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.3",
    "@nestjs/testing": "12.0.3",
    "@types/express": "5.0.6",
    "@types/node": "24.13.5",
    "@types/pg": "8.23.1",
    "pino-pretty": "13.1.3"
  }
}
