{
  "name": "@smartsite/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "test:integration": "tsc -p tsconfig.test.json && node --test .test-build/test/integration/*.test.js",
    "typeorm": "typeorm",
    "db:migrate:run": "pnpm build && typeorm migration:run -d dist/database/typeorm.data-source.js",
    "db:migrate:revert": "pnpm build && typeorm migration:revert -d dist/database/typeorm.data-source.js",
    "db:migrate:show": "pnpm build && typeorm migration:show -d dist/database/typeorm.data-source.js"
  },
  "dependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/typeorm": "12.0.1",
    "@smartsite/contracts": "workspace:*",
    "dotenv": "16.4.7",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.3",
    "@nestjs/testing": "12.0.3",
    "@types/node": "24.13.5",
    "@types/pg": "8.23.1"
  }
}
